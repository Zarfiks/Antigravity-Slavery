{
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim":      { "type": "string" },
          "severity":   { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "file":       { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end":   { "type": "integer" },
          "evidence":   { "type": "string" },
          "confidence": { "type": "number" }
        },
        "required": ["claim", "severity", "file", "line_start", "evidence", "confidence"]
      }
    }
  },
  "required": ["summary", "findings"]
}
